{
  "name": "math-meridio-client-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,ts,tsx}\"",
    "cy:open": "npx cypress open",
    "test:audit": "npm audit --production --audit-level=moderate",
    "test:lint": "eslint src --ext ts --ext tsx --ext js --ext jsx --max-warnings 0",
    "test:types": "tsc --noEmit",
    "test:format": "prettier --check \"src/**/*.{js,ts,tsx}\"",
    "license:fix": "license-check-and-add remove -f license-config.json && license-check-and-add add -f license-config.json",
    "test:license": "license-check-and-add check -f license-config.json"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.5",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/generative-ai": "^0.24.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@isoterik/react-word-cloud": "^1.3.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/x-charts": "^9.10.1",
    "@mui/x-data-grid": "^9.10.1",
    "@react-oauth/google": "^0.13.5",
    "@reduxjs/toolkit": "^2.12.0",
    "aws-amplify": "^6.19.0",
    "axios": "^1.18.1",
    "jsonschema": "^1.5.0",
    "lodash": "^4.18.1",
    "motion": "^12.42.2",
    "openai": "^6.48.0",
    "partycles": "^1.2.6",
    "phaser": "^4.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-json-view-lite": "^2.5.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.1",
    "react-speech-recognition": "^4.0.1",
    "react-toastify": "^11.1.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "redux-logger": "^3.0.6",
    "styled-components": "^6.4.4",
    "tss-react": "^4.9.21",
    "tts-react": "^4.1.4",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@simonsmith/cypress-image-snapshot": "^10.0.4",
    "@types/cypress-dotenv": "^3.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-speech-recognition": "^3.9.6",
    "@types/redux-logger": "^3.0.13",
    "@vitejs/plugin-react": "^6.0.3",
    "cypress": "^15.19.0",
    "cypress-dotenv": "^3.0.1",
    "cypress-localstorage-commands": "^2.3.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "license-check-and-add": "^4.0.5",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
